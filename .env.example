# Context Loom — environment
# Copy to .env and set strong values. All API-key auth (MCP /mcp + REST /health)
# requires this bearer token when CONTEXT_LOOM_AUTH=apikey (the default).

APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-to-a-long-random-secret

CONTEXT_LOOM_AUTH=apikey
CONTEXT_LOOM_API_KEY=change-me-to-a-long-random-secret
