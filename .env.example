# Context Loom — environment
# Copy to .env and set strong values.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me-to-a-long-random-secret

# Auth mode: apikey (default) or oauth (v2.0)
CONTEXT_LOOM_AUTH=apikey

# API key for MCP /mcp + REST /health (same key)
CONTEXT_LOOM_API_KEY=change-me-to-a-long-random-secret

# Comma-separated hostnames (no ports; IPv6 bracketed) the MCP endpoint will
# accept in Host/Origin headers (DNS-rebinding protection). Unset = localhost
# only. REQUIRED when deployed under a real hostname.
CONTEXT_LOOM_ALLOWED_HOSTS=

# --- Notify (ntfy) ---
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=general
# ntfy access token (Bearer auth). Required when the ntfy server disallows
# anonymous publishing (auth-default-access: deny-all), which is the norm
# for self-hosted instances. Generate with `ntfy token generate`.
# NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Notify (Discord) ---
# DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# --- Vital Pulse (type: http) ---
# VITAL_PULSE_URL=https://vital-pulse.internal
# VITAL_PULSE_API_KEY=your-api-key

# --- Penny Track (type: http) ---
# PENNY_TRACK_URL=https://penny-track.internal
# PENNY_API_KEY=your-api-key

# --- Probes ---
# PROBE_MODE=connectivity      # connectivity | static
# PROBE_INTERVAL=60            # seconds; 0 = probe once, no schedule
# PROBE_TIMEOUT=3              # seconds per target
# PROBE_ON_BOOT=true           # true | false

# --- OTel (optional, v1+) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
